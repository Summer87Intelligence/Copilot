# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ZetaSoftware — credenciales de empresa
ZETA_COMPANY_CODE=your_zeta_company_code
ZETA_COMPANY_KEY=your_zeta_company_key
ZETA_ROLE_CODE=1

# ZetaSoftware — credenciales de desarrollador
ZETA_DEVELOPER_CODE=your_developer_code
ZETA_DEVELOPER_KEY=your_developer_key

# Aliases en español (usados internamente por algunos scripts)
ZETA_EMPRESA_CODIGO=your_zeta_company_code
ZETA_EMPRESA_CLAVE=your_zeta_company_key
ZETA_DESARROLLADOR_CODIGO=your_developer_code
ZETA_DESARROLLADOR_CLAVE=your_developer_key
