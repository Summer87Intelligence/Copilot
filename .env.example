# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Copilot session (P1-002) — OBLIGATORIO en producción; generar ≥32 bytes aleatorios
# (p. ej. `openssl rand -base64 48` o `node -e "console.log(crypto.randomBytes(48).toString('base64'))"`).
# Debe ser un valor fuerte y NO commitear el secreto real. Al rotar o activar por
# primera vez, todas las sesiones existentes quedan inválidas.
COPILOT_SESSION_SIGNING_SECRET=replace_with_long_random_secret

# Cookie de sesión: `secure` (default seguro). Sin esta variable el default es
# producción-like (HTTPS → secure=true), así que NO hace falta en producción.
# Para probar un build de producción en LOCAL sobre HTTP (`npm run build && npm run start`
# en http://localhost:3000) el navegador descarta la cookie `secure`, por lo que el
# login queda en loop. En ese caso —y SOLO para localhost HTTP— exportar:
#   COPILOT_SESSION_COOKIE_SECURE=false
# En producción HTTPS debe ser `true` o quedar sin definir (default seguro). No degradar
# el default de producción dejando `false` commiteado.
# COPILOT_SESSION_COOKIE_SECURE=false

# ZetaSoftware — credenciales de empresa
ZETA_COMPANY_CODE=your_zeta_company_code
ZETA_COMPANY_KEY=your_zeta_company_key
ZETA_ROLE_CODE=1

# ZetaSoftware — credenciales de desarrollador
ZETA_DEVELOPER_CODE=your_developer_code
ZETA_DEVELOPER_KEY=your_developer_key

# Aliases en español (usados internamente por algunos scripts)
ZETA_EMPRESA_CODIGO=your_zeta_company_code
ZETA_EMPRESA_CLAVE=your_zeta_company_key
ZETA_DESARROLLADOR_CODIGO=your_developer_code
ZETA_DESARROLLADOR_CLAVE=your_developer_key
